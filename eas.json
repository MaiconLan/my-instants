{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        // Uma arquitetura, nao quatro: todo celular Android vendido desde ~2017 e arm64,
        // e compilar C++ (reanimated, worklets, screens...) quatro vezes e o que mais
        // demora no build. Nao instala em aparelho de 32 bits nem em emulador x86.
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
      }
    }
  }
}
